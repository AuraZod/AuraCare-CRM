{
  "name": "auracare-desktop",
  "version": "1.0.0",
  "description": "AuraCare Healthcare Management System - Desktop Application",
  "main": "main.js",
  "author": "AuraZod (github.com/AuraZod)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:frontend\" \"wait-on http://localhost:8080 && electron .\"",
    "dev:frontend": "cd ../frontend && npm run dev",
    "build": "npm run build:frontend && electron-builder",
    "build:frontend": "cd ../frontend && npm run build && npx shx rm -rf ../desktop/frontend-dist && npx shx cp -r dist ../desktop/frontend-dist",
    "build:win": "npm run build:frontend && electron-builder --win",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "build:linux": "npm run build:frontend && electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.auracare.desktop",
    "productName": "AuraCare",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend-dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "icon": "assets/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
